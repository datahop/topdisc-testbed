#cloud-config
# Every server: sysctls, limits, the hostagent unit. The driver pushes the
# binaries over SSH and starts the agent; nothing is fetched at boot.
write_files:
  - path: /etc/sysctl.d/90-topdisc.conf
    content: |
      net.core.rmem_max = 8388608
      net.core.wmem_max = 8388608
      net.core.rmem_default = 4194304
      net.core.wmem_default = 4194304
      net.core.netdev_max_backlog = 250000
      net.ipv4.ip_forward = 1
      net.ipv4.conf.all.rp_filter = 0
      net.ipv4.conf.default.rp_filter = 0
      net.ipv4.neigh.default.gc_thresh1 = 8192
      net.ipv4.neigh.default.gc_thresh2 = 32768
      net.ipv4.neigh.default.gc_thresh3 = 65536
      fs.file-max = 4000000
      kernel.pid_max = 4194304
  - path: /etc/security/limits.d/90-topdisc.conf
    content: |
      * soft nofile 1000000
      * hard nofile 1000000
  - path: /etc/systemd/system/hostagent.service
    content: |
      [Unit]
      Description=topdisc hostagent
      After=network-online.target
      [Service]
      ExecStart=/opt/topdisc/hostagent -serve :9000 -node-binary /opt/topdisc/topdisc-node -workdir /opt/topdisc/run
      LimitNOFILE=1000000
      LimitNPROC=1000000
      Restart=always
      [Install]
      WantedBy=multi-user.target
runcmd:
  - sysctl --system
  - mkdir -p /opt/topdisc && chmod 1777 /opt/topdisc
  # The private network's MTU is 1450 and the node namespaces use 1500:
  # clamp forwarded TCP to the path so the connection model's RLPx streams
  # are not blackholed. UDP discovery packets stay under 1280.
  - nft add table ip mangle && nft add chain ip mangle forward '{ type filter hook forward priority -150; }' && nft add rule ip mangle forward tcp flags syn tcp option maxseg size set rt mtu
  # The hosts' node /16s are routed by the network (one route per host), but
  # a server only gets a route for the private subnet itself; without this
  # the node traffic leaves by the public interface. The private interface
  # comes up by DHCP a little after boot.
  - for i in $(seq 1 60); do dev=$(ip -o route get 172.20.0.1 2>/dev/null | awk '{print $3}'); [ -n "$dev" ] && [ "$dev" != eth0 ] && break; sleep 2; done; ip route replace 10.0.0.0/8 via 172.20.0.1 dev "$dev"
  - systemctl daemon-reload
  - touch /opt/topdisc/ready
